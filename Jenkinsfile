pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Hello Bharathi! Build stage started.'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage completed successfully.'
            }
        }

        stage('Post') {
            steps {
                echo 'Pipeline completed successfully!'
                echo 'Ready for the next DevOps step.'
            }
        }
    }
}
